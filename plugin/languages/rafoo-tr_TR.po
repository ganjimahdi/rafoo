msgstr "%s adresine test gönder"

#: src/Admin/Strings.php:528
msgid "Test email sent. Check the inbox."
msgstr "Test e-postası gönderildi. Gelen kutusunu kontrol edin."

#: src/Admin/Strings.php:529
msgid "Save changes"
msgstr "Değişiklikleri kaydet"

#: src/Admin/Strings.php:531
msgid "Send a suggestion"
msgstr "Öneri gönder"

#: src/Admin/Strings.php:532
msgid "Tell the Rafoo team what is missing or what went wrong."
msgstr "Rafoo ekibine neyin eksik olduğunu veya neyin ters gittiğini anlatın."

#: src/Admin/Strings.php:533
msgid "Message"
msgstr "Mesaj"

#: src/Admin/Strings.php:534
msgid "Email or phone (optional)"
msgstr "E-posta veya telefon (isteğe bağlı)"

#: src/Admin/Strings.php:535
msgid "Only if you would like an answer."
msgstr "Yalnızca yanıt almak isterseniz."

#: src/Admin/Strings.php:536
msgid "Your message is sent to rafoo.ir with the versions of WordPress, PHP and Rafoo. Nothing is sent until you press Send."
msgstr "Mesajınız WordPress, PHP ve Rafoo sürümleriyle birlikte rafoo.ir'ye gönderilir. Gönder'e basana kadar hiçbir şey gönderilmez."

#: src/Admin/Strings.php:537
msgid "Please write a little more."
msgstr "Lütfen biraz daha yazın."

#: src/Admin/Strings.php:538
msgid "Thank you. Your message was sent."
msgstr "Teşekkürler. Mesajınız gönderildi."

#: src/Admin/Strings.php:539
msgid "Send"
msgstr "Gönder"

