msgstr "Gönderen adresi (isteğe bağlı)"

#: src/Admin/Strings.php:521
msgid "Many servers only accept emails from their own domain. If so, enter an address on that domain."
msgstr "Birçok sunucu yalnızca kendi alan adından gelen e-postaları kabul eder. Öyleyse o alan adında bir adres girin."

#: src/Admin/Strings.php:522
msgid "Save mail server"
msgstr "Posta sunucusunu kaydet"

#: src/Admin/Strings.php:523
msgid "Mail server saved."
msgstr "Posta sunucusu kaydedildi."

#: src/Admin/Strings.php:525
