msgstr "%1$s artık %2$s sürümünde ama sitede hâlâ bir sorun var: %3$s"

#: src/Admin/Strings.php:308
msgid "Check the site now"
msgstr "Siteyi şimdi kontrol et"

#: src/Admin/Strings.php:309
msgid "The home page, the login page and the dashboard all load without errors."
msgstr "Ana sayfa, giriş sayfası ve panel hatasız yükleniyor."

