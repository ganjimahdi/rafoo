msgstr "SSL/TLS"

#: src/Admin/Strings.php:657
msgid "None"
msgstr "بدون رمزگذاری"

#: src/Admin/Strings.php:658
msgid "Without encryption the password and emails cross the network in plain text. Use it only for a server on the same host."
msgstr "بدون رمزگذاری، رمز عبور و متن ایمیل‌ها بدون محافظت از شبکه عبور می‌کنند. فقط برای سرور ایمیلِ روی همین هاست استفاده کنید."

#: src/Admin/Strings.php:659 src/Admin/Strings.php:967 src/Backup/Installer.php:40
msgid "Username"
msgstr "نام کاربری"

#: src/Admin/Strings.php:660 src/Backup/Installer.php:41
msgid "Password"
msgstr "رمز عبور"

#: src/Admin/Strings.php:661 src/Admin/Strings.php:957
msgid "Saved. Leave empty to keep it."
msgstr "ذخیره شده است. برای نگه داشتن همین رمز، خالی بگذارید."

#: src/Admin/Strings.php:662
msgid "Sender address (optional)"
msgstr "آدرس فرستنده (اختیاری)"

#: src/Admin/Strings.php:663
msgid "Many servers only accept emails from their own domain. If so, enter an address on that domain."
msgstr "بسیاری از سرورها فقط ایمیل‌های دامنه خودشان را می‌پذیرند. در این صورت آدرسی روی همان دامنه وارد کنید."

#: src/Admin/Strings.php:664
msgid "Save mail server"
msgstr "ذخیره سرور ایمیل"

#: src/Admin/Strings.php:665
msgid "Mail server saved."
msgstr "سرور ایمیل ذخیره شد."

#: src/Admin/Strings.php:667
msgid "Mail server removed."
msgstr "سرور ایمیل حذف شد."

#. translators: %s: email address
#: src/Admin/Strings.php:669
#, php-format
msgid "Send a test to %s"
msgstr "ارسال آزمایشی به %s"

#: src/Admin/Strings.php:670
msgid "Test email sent. Check the inbox."
msgstr "ایمیل آزمایشی فرستاده شد. صندوق ورودی را بررسی کنید."

#: src/Admin/Strings.php:671
msgid "Save changes"
msgstr "ذخیره تغییرات"

#: src/Admin/Strings.php:673
msgid "Send a suggestion"
msgstr "ارسال پیشنهاد"

#: src/Admin/Strings.php:674
msgid "Tell the Rafoo team what is missing or what went wrong."
msgstr "به تیم رفو بگویید چه چیزی کم است یا کجا مشکل پیش آمد."

#: src/Admin/Strings.php:675
msgid "Message"
msgstr "پیام"

#: src/Admin/Strings.php:676
msgid "Email or phone (optional)"
msgstr "ایمیل یا تلفن (اختیاری)"

#: src/Admin/Strings.php:677
msgid "Only if you would like an answer."
msgstr "فقط اگر پاسخ می‌خواهید."

#: src/Admin/Strings.php:678
msgid "Your message is sent to rafoo.ir with the versions of WordPress, PHP and Rafoo. Nothing is sent until you press Send."
msgstr "پیام شما همراه نسخه وردپرس، PHP و رفو به rafoo.ir فرستاده می‌شود. تا روی «ارسال» نزنید، چیزی فرستاده نمی‌شود."

#: src/Admin/Strings.php:679
msgid "Please write a little more."
msgstr "لطفاً کمی بیشتر بنویسید."

#: src/Admin/Strings.php:680
msgid "Thank you. Your message was sent."
msgstr "ممنون، پیام شما فرستاده شد."

#: src/Admin/Strings.php:681
msgid "Send"
msgstr "ارسال"

#. translators: %s: number
#: src/Admin/Strings.php:684
#, php-format
