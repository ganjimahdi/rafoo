#: src/Admin/AdminBar.php:20
msgid "Rafoo: paused"
msgstr "رفو: متوقف"

#: src/Admin/AdminBar.php:22 src/Admin/Strings.php:576
msgid "Rafoo is paused and changes nothing on the site."
msgstr "رفو متوقف است و چیزی را در سایت تغییر نمی‌دهد."

#: src/Admin/AdminBar.php:33 src/Admin/Strings.php:18
msgid "Rafoo: outage mode"
msgstr "رفو: حالت قطعی"

#: src/Admin/AdminBar.php:35
msgid "The international internet is down. Rafoo is serving local copies."
msgstr "اینترنت بین‌الملل قطع است. رفو نسخه‌های محلی را ارائه می‌کند."

#: src/Admin/Page.php:23 src/Admin/Page.php:24 src/Admin/Page.php:35 src/Admin/Page.php:36
msgid "Rafoo"
msgstr "رفو"

#: src/Admin/Page.php:46 src/Admin/SiteHealth.php:169
msgid "Network settings"
msgstr "تنظیمات شبکه"

#: src/Admin/Page.php:51 src/Admin/Strings.php:23 src/Admin/Strings.php:57
msgid "Settings"
msgstr "تنظیمات"

#: src/Admin/Page.php:59 src/Admin/Strings.php:129
msgid "Loading…"
msgstr "در حال بارگذاری…"

#: src/Admin/Page.php:60
msgid "The Rafoo dashboard needs JavaScript."
msgstr "پیشخوان رفو به جاوااسکریپت نیاز دارد."

#: src/Admin/Rest.php:457
msgid "You are not allowed to change this."
msgstr "اجازه تغییر این مورد را ندارید."

#: src/Admin/Rest.php:460
msgid "The previous version could not be put back. The files were left as they were."
msgstr "نسخه قبلی برگردانده نشد. فایل‌ها همان‌طور که بودند ماندند."

#: src/Admin/Rest.php:540
msgid "This message is no longer waiting."
msgstr "این پیام دیگر در انتظار نیست."

#: src/Admin/Rest.php:548
msgid "Enter a valid mail server address, for example mail.example.ir."
msgstr "نشانی معتبر سرور ایمیل وارد کنید، مثلاً mail.example.ir."

#: src/Admin/Rest.php:556
msgid "Save a mail server first."
msgstr "اول یک سرور ایمیل ذخیره کنید."

#: src/Admin/Rest.php:601
msgid "Please write between 5 and 2000 characters."
msgstr "لطفاً بین ۵ تا ۲۰۰۰ نویسه بنویسید."

#: src/Admin/Rest.php:605
msgid "Please wait a minute before sending another message."
msgstr "لطفاً یک دقیقه صبر کنید و بعد پیام دیگری بفرستید."

#: src/Admin/Rest.php:608
msgid "rafoo.ir could not be reached. Please try again later."
msgstr "ارتباط با rafoo.ir برقرار نشد. لطفاً بعداً دوباره تلاش کنید."

#: src/Admin/Rest.php:651
msgid "This file is no longer in the list."
msgstr "این فایل دیگر در فهرست نیست."

#: src/Admin/SiteHealth.php:21
msgid "Rafoo connection state"
msgstr "وضعیت اتصال رفو"

#: src/Admin/SiteHealth.php:22
msgid "Rafoo connection checks"
msgstr "بررسی اتصال رفو"

#: src/Admin/SiteHealth.php:23
msgid "Rafoo local copies"
msgstr "نسخه‌های محلی رفو"

#: src/Admin/SiteHealth.php:24 src/Admin/SiteHealth.php:102
msgid "Rafoo is active"
msgstr "رفو فعال است"

#: src/Admin/SiteHealth.php:37
msgid "This server cannot reach any network"
msgstr "این سرور به هیچ شبکه‌ای دسترسی ندارد"

#: src/Admin/SiteHealth.php:37
msgid "Rafoo could not reach servers inside or outside Iran. The problem is the network of this server, so Rafoo leaves the mode as it is. Ask your host to check the server connection."
msgstr "رفو به سرورهای داخل و خارج ایران نرسید. مشکل از شبکه همین سرور است، پس رفو حالت را تغییر نمی‌دهد. از میزبان بخواهید اتصال سرور را بررسی کند."

#: src/Admin/SiteHealth.php:40
msgid "Rafoo is fixed in outage mode by hand"
msgstr "رفو به‌طور دستی روی حالت قطعی ثابت شده است"

#: src/Admin/SiteHealth.php:40
msgid "Outage mode stays on even when the internet works, so outside requests keep failing at once. Switch the mode back to automatic when you have finished testing."
msgstr "حالت قطعی حتی وقتی اینترنت وصل است روشن می‌ماند و درخواست‌های خارجی همچنان فوراً رد می‌شوند. پس از پایان آزمایش، حالت را به خودکار برگردانید."

#: src/Admin/SiteHealth.php:43
msgid "Rafoo is fixed in online mode by hand"
msgstr "رفو به‌طور دستی روی حالت آنلاین ثابت شده است"

#: src/Admin/SiteHealth.php:43
msgid "Outage mode will not switch on by itself, so during an outage pages and the dashboard will wait for unreachable servers. Switch the mode back to automatic."
msgstr "حالت قطعی خودکار روشن نمی‌شود، پس در قطعی صفحه‌ها و پیشخوان منتظر سرورهای دور از دسترس می‌مانند. حالت را به خودکار برگردانید."

#: src/Admin/SiteHealth.php:46 src/Admin/Strings.php:81
msgid "The international internet is down"
msgstr "اینترنت بین‌الملل قطع است"

#: src/Admin/SiteHealth.php:46
msgid "Rafoo has switched on outage mode by itself: local copies are served and requests to unreachable servers fail at once. It switches off by itself when the internet is back."
msgstr "رفو خودکار حالت قطعی را روشن کرده است: نسخه‌های محلی ارائه می‌شوند و درخواست به سرورهای دور از دسترس فوراً رد می‌شود. با برگشت اینترنت خودکار خاموش می‌شود."

#: src/Admin/SiteHealth.php:48
msgid "Rafoo detects outages automatically"
msgstr "رفو قطعی را خودکار تشخیص می‌دهد"

#: src/Admin/SiteHealth.php:48
msgid "The international internet is reachable. If it is cut off, Rafoo switches on outage mode by itself within about three minutes."
msgstr "اینترنت بین‌الملل در دسترس است. اگر قطع شود، رفو حدود سه دقیقه بعد خودکار حالت قطعی را روشن می‌کند."

#: src/Admin/SiteHealth.php:58
msgid "WP-Cron is turned off on this site and no system cron job runs it, so Rafoo cannot notice an outage. Add a cron job that requests wp-cron.php every minute."
msgstr "WP-Cron در این سایت خاموش است و کرون‌جاب سروری هم آن را اجرا نمی‌کند، پس رفو قطعی را نمی‌فهمد. یک کرون‌جاب بسازید که هر دقیقه wp-cron.php را صدا بزند."

#: src/Admin/SiteHealth.php:59
msgid "WP-Cron runs only when someone visits the site, so on quiet sites an outage is noticed late. Add a cron job that requests wp-cron.php every minute."
msgstr "WP-Cron فقط با بازدید از سایت اجرا می‌شود، پس در سایت‌های کم‌بازدید قطعی دیر فهمیده می‌شود. یک کرون‌جاب بسازید که هر دقیقه wp-cron.php را صدا بزند."

#: src/Admin/SiteHealth.php:60
msgid "Rafoo connection checks are not running on time"
msgstr "بررسی اتصال رفو سر وقت اجرا نمی‌شود"

#: src/Admin/SiteHealth.php:62
msgid "Rafoo connection checks run on time"
msgstr "بررسی اتصال رفو سر وقت اجرا می‌شود"

#: src/Admin/SiteHealth.php:62
msgid "Rafoo checks the connection every minute in the background."
msgstr "رفو هر دقیقه در پس‌زمینه اتصال را بررسی می‌کند."

#: src/Admin/SiteHealth.php:71
msgid "Rafoo cannot save local copies"
msgstr "رفو نمی‌تواند نسخه محلی ذخیره کند"

#. translators: %s: folder path
#: src/Admin/SiteHealth.php:73
#, php-format
msgid "The folder %s is not writable, so libraries and fonts cannot be copied to this server. Ask your host to give PHP write access to the uploads folder."
msgstr "پوشه %s قابل نوشتن نیست، پس کتابخانه‌ها و فونت‌ها روی این سرور کپی نمی‌شوند. از میزبان بخواهید به PHP اجازه نوشتن در پوشه uploads بدهد."

#. translators: %d: number of files
#: src/Admin/SiteHealth.php:83
#, php-format
msgid "Rafoo could not copy %d files"
msgstr "رفو %d فایل را نتوانست کپی کند"

#: src/Admin/SiteHealth.php:84
msgid "These files are still loaded from their original address and will not load during an outage. Open Rafoo › Files to see why and try again."
msgstr "این فایل‌ها هنوز از نشانی اصلی بارگذاری می‌شوند و در قطعی باز نمی‌شوند. برای دیدن دلیل و تلاش دوباره، رفو › فایل‌ها را باز کنید."

#. translators: %d: number of files
#: src/Admin/SiteHealth.php:92
#, php-format
msgid "Rafoo serves %d local copies"
msgstr "رفو %d نسخه محلی ارائه می‌کند"

#: src/Admin/SiteHealth.php:93
msgid "Libraries and fonts from public CDNs are served from this server."
msgstr "کتابخانه‌ها و فونت‌های CDNهای عمومی از همین سرور ارائه می‌شوند."

#: src/Admin/SiteHealth.php:100
msgid "Rafoo is paused"
msgstr "رفو متوقف است"

#: src/Admin/SiteHealth.php:100
msgid "Rafoo changes nothing on the site while it is paused, so it cannot help during an outage. Resume it when you have finished testing."
msgstr "رفو در توقف هیچ تغییری در سایت نمی‌دهد و در قطعی کمکی نمی‌کند. پس از پایان آزمایش آن را دوباره فعال کنید."

#: src/Admin/SiteHealth.php:102
msgid "Rafoo makes the changes chosen in its settings."
msgstr "رفو تغییراتی را که در تنظیمات انتخاب شده انجام می‌دهد."

