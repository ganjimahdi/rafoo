msgid "The key is not correct."
msgstr "المفتاح غير صحيح."

#: src/Backup/Installer.php:32
msgid "Too many failed attempts. Send the file again."
msgstr "محاولات فاشلة كثيرة. أرسل الملف مجددًا."

#: src/Backup/Installer.php:33
msgid "Restore finished. Go to the dashboard"
msgstr "انتهت الاستعادة. انتقل إلى لوحة التحكم"

#: src/Backup/Installer.php:35
msgid "Opening the backup"
msgstr "فتح النسخة الاحتياطية"

#: src/Backup/Installer.php:36
msgid "Restoring files"
msgstr "استعادة الملفات"

#: src/Backup/Installer.php:37
msgid "Setting up wp-config.php"
msgstr "ضبط wp-config.php"

#: src/Backup/Installer.php:38
msgid "Restoring the database"
msgstr "استعادة قاعدة البيانات"

#: src/Backup/Installer.php:39
msgid "Updating the site address"
msgstr "تحديث عنوان الموقع"

#: src/Backup/Installer.php:40
msgid "Cleaning up"
