#: src/Admin/Strings.php:364
msgid "the restored site did not load, so the previous database was put back"
msgstr "لم يُحمَّل الموقع المستعاد، فأُعيدت قاعدة البيانات السابقة"

#: src/Admin/Strings.php:365
msgid "the other site did not finish in time"
