#, php-format
msgid "Last check: %s"
msgstr "آخر فحص: %s"

#. translators: %s: date and time
#: src/Admin/Strings.php:86
#, php-format
msgid "down since %s"
msgstr "مقطوع منذ %s"

#. translators: %s: date and time
#: src/Admin/Strings.php:88
#, php-format
msgid "available since %s"
msgstr "متاح منذ %s"

#: src/Admin/Strings.php:93
msgid "Automatic switches by itself. Choose a fixed mode only to test or when detection is wrong."
msgstr "الوضع التلقائي يتبدّل من تلقاء نفسه. اختر وضعًا ثابتًا فقط للاختبار أو عندما يكون الاكتشاف خاطئًا."

#: src/Admin/Strings.php:94 src/Admin/Strings.php:1154
msgid "Automatic"
msgstr "تلقائي"

#: src/Admin/Strings.php:95
msgid "Always outage"
msgstr "انقطاع دائمًا"

#: src/Admin/Strings.php:96
msgid "Always online"
msgstr "متصل دائمًا"

#: src/Admin/Strings.php:97
msgid "Outage mode is fixed by hand. Rafoo will not switch back by itself."
msgstr "وضع الانقطاع مثبّت يدويًا. لن يعود Rafoo من تلقاء نفسه."

#: src/Admin/Strings.php:98
msgid "Online mode is fixed by hand. Rafoo will not switch to outage mode by itself."
msgstr "وضع الاتصال مثبّت يدويًا. لن ينتقل Rafoo إلى وضع الانقطاع من تلقاء نفسه."

