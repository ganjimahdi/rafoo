msgstr "Локальные копии библиотек и шрифтов, всегда"

#: src/Admin/Strings.php:246
msgid "Outside services replaced only during outages"
msgstr "Внешние сервисы заменяются только при отключениях"

#: src/Admin/Strings.php:247 src/Admin/Strings.php:257
msgid "Safe updates and a daily backup"
msgstr "Безопасные обновления и ежедневная резервная копия"

#: src/Admin/Strings.php:249
msgid "The site works as before until the internet goes down."
msgstr "Сайт работает как раньше, пока не пропадёт интернет."

#: src/Admin/Strings.php:250
msgid "Nothing changes while the internet works"
msgstr "Пока интернет работает, ничего не меняется"

#: src/Admin/Strings.php:251
msgid "Local copies and replacements during outages"
msgstr "Локальные копии и замены при отключениях"

#: src/Admin/Strings.php:252
msgid "Safe updates, no automatic backup"
msgstr "Безопасные обновления, без автоматического резервного копирования"

#: src/Admin/Strings.php:253
msgid "Maximum speed and privacy"
msgstr "Максимальная скорость и приватность"

#: src/Admin/Strings.php:254
msgid "Uses as few outside services as possible."
msgstr "Использует как можно меньше внешних сервисов."

#: src/Admin/Strings.php:255
msgid "Local avatars and captcha, always"
msgstr "Локальные аватары и капча, всегда"

#: src/Admin/Strings.php:258
msgid "Suggested"
msgstr "Предлагается"

#: src/Admin/Strings.php:259
msgid "Use this setup"
msgstr "Использовать эту настройку"

#: src/Admin/Strings.php:260
msgid "A weekly anonymous report helps the mirror cover more files. No site address or personal data."
msgstr "Еженедельный анонимный отчёт помогает зеркалу охватить больше файлов. Без адреса сайта и личных данных."

#: src/Admin/Strings.php:261
msgid "Later"
msgstr "Позже"

#: src/Admin/Strings.php:262
msgid "Set up step by step"
msgstr "Настроить по шагам"

#: src/Admin/Strings.php:263
msgid "Files and fonts"
msgstr "Файлы и шрифты"

#: src/Admin/Strings.php:264
msgid "Libraries and fonts the site loads from public networks."
msgstr "Библиотеки и шрифты, которые сайт загружает из публичных сетей."

#: src/Admin/Strings.php:266
msgid "What should happen to outside services when the international internet is down."
msgstr "Что делать с внешними сервисами, когда пропадает международный интернет."

#: src/Admin/Strings.php:268
msgid "Protection against updates that break the site."
msgstr "Защита от обновлений, которые ломают сайт."

#: src/Admin/Strings.php:269 src/Admin/Strings.php:313
msgid "Backup"
