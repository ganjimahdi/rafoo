#: src/Admin/Strings.php:272
msgid "Rafoo sends nothing unless you allow it."
msgstr "Rafoo ничего не отправляет без вашего разрешения."

#: src/Admin/Strings.php:273
msgid "Copies are kept on this host. Another server can be added later on the Backup tab."
msgstr "Копии хранятся на этом хостинге. Другой сервер можно добавить позже на вкладке «Резервное копирование»."

#: src/Admin/Strings.php:274
msgid "Back"
msgstr "Назад"

#: src/Admin/Strings.php:275
