msgid "Encryption"
msgstr "Шифрование"

#: src/Admin/Strings.php:507
msgid "With a password, backups are encrypted before they leave this site. Without the password they cannot be restored, so keep it somewhere safe."
msgstr "С паролем копии шифруются до того, как покинут сайт. Без пароля их нельзя восстановить, поэтому храните его в надёжном месте."

#: src/Admin/Strings.php:508
msgid "New backups are encrypted."
msgstr "Новые копии шифруются."

#: src/Admin/Strings.php:509
msgid "Backups are not encrypted."
msgstr "Копии не шифруются."

#: src/Admin/Strings.php:510
msgid "Password saved. The next backup will be encrypted."
msgstr "Пароль сохранён. Следующая копия будет зашифрована."

#: src/Admin/Strings.php:511
msgid "Turn off encryption"
msgstr "Выключить шифрование"

#: src/Admin/Strings.php:512
msgid "Encryption turned off for new backups."
msgstr "Шифрование новых копий выключено."

