#, php-format
msgid "A copy was removed: %s"
msgstr "Копия удалена: %s"

#: src/Admin/Strings.php:1044
msgid "The group of hosts ended on this site"
msgstr "Группа хостингов на этом сайте завершена"

#. translators: %s: domain
#: src/Admin/Strings.php:1046
#, php-format
msgid "DNS records updated for %s"
